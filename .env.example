# ════════════════════════════════════════════════════════════
# RAG-LLM Multi-Agent — Variables d'Environnement
# ════════════════════════════════════════════════════════════
# Copier ce fichier en .env et remplir les valeurs.
#   cp .env.example .env
# ════════════════════════════════════════════════════════════

# ── Clés API (au moins une est requise selon LLM_PROVIDER) ──
OPENAI_API_KEY=sk-votre-cle-openai-ici
HUGGINGFACE_TOKEN=hf_votre-token-huggingface-ici
# Si OpenAI renvoie 429 insufficient_quota : LLM_PROVIDER=huggingface (+ token HF ci-dessus)
# Valeurs : auto | openai | huggingface
LLM_PROVIDER=auto
# Modèle OpenAI si LLM_PROVIDER=openai ou auto avec clé OpenAI
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Modèle « chat » sur le routeur HF (/v1/chat/completions) — vérifier hf.co/settings/inference-providers
# HF_CHAT_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
# Ancien endpoint legacy (embeddings locaux peuvent encore le lire) :
# HF_INFERENCE_ENDPOINT=https://router.huggingface.co
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# ── Flask ───────────────────────────────────────────────────
FLASK_SECRET_KEY=changez-cette-cle-en-production
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
# Sur macOS, le port 5000 est souvent utilisé par AirPlay ; utiliser 5001 si besoin
FLASK_PORT=5001

# ── RAG / PDFs (modifiable depuis l’onglet Paramètres) ───────
# RAG_TOP_K=5
# CHUNK_SIZE=512

# ── Dataset depuis PDFs (plafond par défaut pour l’API web) ─
# DATASET_PDF_MAX_PAIRS=60

# ── Benchmark : IDs modèles HF (routeur /v1/chat/completions) ─
# BENCHMARK_HF_MODEL_QWEN=Qwen/Qwen2.5-7B-Instruct
# BENCHMARK_HF_MODEL_MISTRAL=Qwen/Qwen2.5-7B-Instruct
# (le 3B est souvent absent des Inference Providers activés ; surcharger si besoin)
# BENCHMARK_HF_MODEL_LLAMA=meta-llama/Llama-3.1-8B-Instruct

# ── Fine-tuning local / Kaggle (GPU) ────────────────────────
# Sans FINETUNE_RUN=1, « python run.py --step finetune » reste en mode sec (pas d’entraînement).
# FINETUNE_RUN=1
# FINETUNE_METHOD=qlora
# FINETUNE_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
# FINETUNE_MAX_SAMPLES=50

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
